{
  "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "build",
      "installDir": "install",
      "generator": "Ninja Multi-Config",
      "toolchainFile": "cmake/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "MeshMC_QT_VERSION_MAJOR": "6",
        "MeshMC_BUILD_ARTIFACT": "$penv{ARTIFACT_NAME}",
        "MeshMC_BUILD_PLATFORM": "$penv{BUILD_PLATFORM}",
        "MeshMC_UPDATE_CHANNEL": "$penv{UPDATE_CHANNEL}",
        "MeshMC_DISABLE_JAVA_DOWNLOADER": "OFF",
        "MeshMC_PLUGINS": "ON",
        "MeshMC_STAGING_PLUGINS": "OFF",
        "ENABLE_LTO": "ON"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux",
      "inherits": [
        "base"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux_qt5",
      "displayName": "Linux (Qt 5)",
      "inherits": [
        "linux"
      ],
      "cacheVariables": {
        "MeshMC_QT_VERSION_MAJOR": "5"
      }
    },
    {
      "name": "macos",
      "displayName": "macOS",
      "inherits": [
        "base"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos_qt5",
      "displayName": "macOS (Qt 5)",
      "inherits": [
        "macos"
      ],
      "cacheVariables": {
        "MeshMC_QT_VERSION_MAJOR": "5"
      }
    },
    {
      "name": "macos_universal",
      "displayName": "macOS (Universal Binary)",
      "inherits": [
        "macos"
      ],
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64;arm64",
        "VCPKG_TARGET_TRIPLET": "universal-osx"
      }
    },
    {
      "name": "windows_mingw",
      "displayName": "Windows (MinGW)",
      "inherits": [
        "base"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows_mingw_qt5",
      "displayName": "Windows (MinGW) (Qt 5)",
      "inherits": [
        "windows_mingw"
      ],
      "cacheVariables": {
        "MeshMC_QT_VERSION_MAJOR": "5"
      }
    },
    {
      "name": "windows_msvc",
      "displayName": "Windows (MSVC)",
      "inherits": [
        "base"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "Embedded"
      }
    },
    {
      "name": "windows_msvc_qt5",
      "displayName": "Windows (MSVC) (Qt 5)",
      "inherits": [
        "windows_msvc"
      ],
      "cacheVariables": {
        "MeshMC_QT_VERSION_MAJOR": "5"
      }
    },
    {
      "hidden": true,
      "name": "Qt",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QTDIR}"
      },
      "vendor": {
        "qt-project.org/Qt": {
          "checksum": "wVa86FgEkvdCTVp1/nxvrkaemJc="
        }
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux",
      "displayName": "Linux",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "configurePreset": "linux"
